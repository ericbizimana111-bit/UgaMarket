# ═════════════════════════════════════════════════════════════════════════════
#  UgaMarket — PRODUCTION settings for DOCKER / YOUR OWN SERVER
# ═════════════════════════════════════════════════════════════════════════════
#  Used by docker-compose.production.yml (docs/DEPLOYMENT_GUIDE.md).
#  Copy to  .env.production  (gitignored) and replace EVERY <placeholder>.
#
#  Hosting on Render (free)?  Do NOT use this file: set the variables in the
#  Render dashboard → Environment (list in render.yaml, guide in
#  docs/FREE_DEPLOYMENT.md). Local development uses backend/.env.
#
#  The API refuses to start if a value is missing, still a <placeholder>,
#  weak, or unsafe — and prints which variable to fix.
#  Generate secrets:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ═════════════════════════════════════════════════════════════════════════════


# ── 1. Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
HOST=0.0.0.0


# ── 2. Database (the compose "postgres" service) ────────────────────────────
POSTGRES_USER=ugamarket
POSTGRES_PASSWORD=<long-random-database-password>
POSTGRES_DB=ugamarket
# Same user/password/db as above; "postgres" is the compose service name.
DATABASE_URL=postgresql://ugamarket:<long-random-database-password>@postgres:5432/ugamarket?schema=public


# ── 3. Login security (32+ chars each, and DIFFERENT from each other) ───────
JWT_SECRET=<random-secret-1>
ADMIN_JWT_SECRET=<random-secret-2>
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=1d


# ── 4. Owner account (created on first setup only) ──────────────────────────
# ADMIN_1 = the OWNER: the ONE super admin, who adds staff and assigns roles.
# Password: 10+ chars, letters and numbers. Other staff are added later in
# the admin console → Staff accounts.
ADMIN_1_EMAIL=<owner-email>
ADMIN_1_PASSWORD=<owner-password>
ADMIN_1_NAME=Owner


# ── 5. Web addresses ────────────────────────────────────────────────────────
# Shop and admin addresses, exact, comma-separated, no trailing "/".
CORS_ORIGIN=https://<shop-domain>,https://<admin-domain>
FRONTEND_URL=https://<shop-domain>


# ── 6. Payments — MTN MoMo & Airtel Money via JJuma Global ──────────────────
PAYMENT_PROVIDER=JJUMA
# TEST with bp_test_ keys first; LIVE with bp_live_ keys once approved.
PAYMENT_MODE=TEST
JJUMA_API_BASE_URL=https://api.jjuma.com
JJUMA_PUBLIC_KEY=<jjuma-public-key>
JJUMA_SECRET_KEY=<jjuma-secret-key>
# JJuma → Tools → Webhooks → signing secret.
# Webhook URL: https://<shop-domain>/api/payments/webhook
JJUMA_WEBHOOK_SECRET=<jjuma-webhook-signing-secret>
PAYMENT_WEBHOOK_SECRET=<random-secret-3>


# ── 7. Product photos ───────────────────────────────────────────────────────
# Optional here: Docker keeps photos on its "uploads" volume. Set it to store
# them on Cloudinary's CDN instead: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=ugamarket


# ── 8. Addresses, maps and delivery distance (OpenStreetMap) ────────────────
GEOCODER_PROVIDER=NOMINATIM
NOMINATIM_URL=https://nominatim.openstreetmap.org
ROUTING_PROVIDER=OSRM
OSRM_URL=https://router.project-osrm.org
GEO_CONTACT_EMAIL=<email-you-read>
ROAD_DISTANCE_FACTOR=1.35


# ── 9. Automatic translation ────────────────────────────────────────────────
# GOOGLE = best Luganda (recommended); MYMEMORY = free, weaker.
TRANSLATION_PROVIDER=MYMEMORY
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_API_KEY=


# ── 10. Starting store settings (first setup only; then admin → Delivery & deposit)
WAREHOUSE_LATITUDE=0.3136
WAREHOUSE_LONGITUDE=32.5811
DELIVERY_BASE_FEE=3000
DELIVERY_FREE_RADIUS_KM=3.0
DELIVERY_PER_KM_RATE=1200
DELIVERY_MINIMUM_FEE=3000
COMMITMENT_RULE_TYPE=PERCENTAGE
COMMITMENT_PERCENTAGE=30.0
COMMITMENT_MIN_AMOUNT=5000


# ── 11. Hosting extras (optional) ───────────────────────────────────────────
# Cloudflare Tunnel token (docs/DEPLOYMENT_GUIDE.md, step 6).
CLOUDFLARE_TUNNEL_TOKEN=
PAYMENT_ATTEMPT_TTL_MINUTES=30
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_AUTH_MAX=20
