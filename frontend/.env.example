# ═════════════════════════════════════════════════════════════════════════════
#  UgaMarket — CUSTOMER SHOP (React) settings
# ═════════════════════════════════════════════════════════════════════════════
#  Local development: copy to  frontend/.env.local  (gitignored) — or skip it:
#  with nothing set, the shop calls "/api" and the dev server forwards it to
#  the API on http://localhost:4000 (see "proxy" in package.json).
#
#  Vercel: Project → Settings → Environment Variables, then REDEPLOY
#  (these values are built into the site; changing them needs a new build).
#
#  Everything here is PUBLIC — anyone can read it in the browser.
#  Never put passwords or secret keys in this file.
# ═════════════════════════════════════════════════════════════════════════════

# Address of the UgaMarket API, ending in /api (no trailing slash).
#   Local (optional):  http://localhost:4000/api
#   Vercel + Render:   https://<your-api>.onrender.com/api
REACT_APP_API_URL=

# Optional: map tiles for the address map. Empty = OpenStreetMap's free tiles.
REACT_APP_MAP_TILE_URL=

# "Continue with Google": the OAuth Web client ID from Google Cloud Console
# (ends in .apps.googleusercontent.com; public, not a secret). Must be the SAME
# value as GOOGLE_CLIENT_ID on the API. Empty = the button shows "coming soon".
REACT_APP_GOOGLE_CLIENT_ID=
