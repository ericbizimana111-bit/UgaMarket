// UgaMarket - Prisma Schema (multi-category marketplace + home services, Uganda)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  DISPATCHER
}

// UgaMarket is delivery-only (pickup stations were retired).
enum DeliveryType {
  HOME_DELIVERY
}

enum OrderStatus {
  PENDING_PAYMENT
  COMMITMENT_PAID
  CONFIRMED
  PREPARING
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  BALANCE_PAID
  COMPLETED
  CANCELLED
  PAYMENT_FAILED
  DELIVERY_FAILED
  REFUNDED
}

enum PaymentType {
  COMMITMENT_ONLINE
  REMAINING_CASH
  BALANCE_ONLINE
}

enum PaymentStatus {
  PENDING
  PROCESSING
  SUCCESS
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentPurpose {
  COMMITMENT
  BALANCE
}

enum PaymentResultCode {
  NONE
  SUCCESS
  INSUFFICIENT_FUNDS
  TIMEOUT
  DECLINED
  CANCELLED_BY_USER
  INVALID_REFERENCE
  PROVIDER_ERROR
}

enum PaymentProvider {
  MOCK
  FLUTTERWAVE
  JJUMA
  MTN_MOMO
  AIRTEL_MONEY
  CASH
}

enum RuleType {
  PERCENTAGE
  FLAT
  TIERED
}

enum ActorType {
  SYSTEM
  ADMIN
  CUSTOMER
}

enum Language {
  EN
  LG
  FR
  SW
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum DeliveryFailureReason {
  CUSTOMER_UNAVAILABLE
  INVALID_ADDRESS
  DRIVER_UNABLE_TO_COMPLETE
  OTHER
}

enum InventoryTransactionType {
  INITIAL_STOCK
  RESTOCK
  ADJUSTMENT
  SALE
  RESERVATION
  RELEASE
  RETURN
  CORRECTION
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  fullName           String    @map("full_name") @db.VarChar(150)
  email              String?   @unique @db.VarChar(255)
  phone              String    @unique @db.VarChar(30)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  // Google account "sub" for "Continue with Google" (null for phone-only accounts)
  googleId           String?   @unique @map("google_id") @db.VarChar(64)
  isActive           Boolean   @default(true) @map("is_active")
  // Contact verification (set only after a successful OTP / Google check).
  emailVerifiedAt    DateTime? @map("email_verified_at")
  phoneVerifiedAt    DateTime? @map("phone_verified_at")
  // Tokens issued before this instant are rejected (a password reset or
  // change signs every other device out).
  passwordChangedAt  DateTime? @map("password_changed_at")
  // Current marketing-communications choice; the history is in consent_records.
  marketingConsent   Boolean   @default(false) @map("marketing_consent")
  marketingConsentAt DateTime? @map("marketing_consent_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")

  addresses       Address[]
  cart            Cart?
  orders          Order[]
  notifications   Notification[]
  wishlists       Wishlist[]
  conversation    Conversation?
  serviceRequests ServiceRequest[]
  securityEvents  SecurityEvent[]
  consentRecords  ConsentRecord[]
  callSessions    CallSession[]

  @@map("users")
}

model Admin {
  id           String   @id @default(uuid()) @db.Uuid
  fullName     String   @map("full_name") @db.VarChar(150)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  role         Role     @default(ADMIN)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  auditLogs             AuditLog[]
  inventoryTransactions InventoryTransaction[]
  assignedDeliveries    Delivery[]              @relation("DeliveryAssignee")
  notificationReads     AdminNotificationRead[]
  chatMessages          ChatMessage[]
  serviceRequestEvents  ServiceRequestEvent[]
  callSessions          CallSession[]

  @@map("admins")
}

model Address {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  title            String   @default("Home") @db.VarChar(50)
  region           String?  @db.VarChar(30)
  district         String   @db.VarChar(100)
  division         String?  @db.VarChar(100)
  streetAddress    String   @map("street_address") @db.Text
  landmark         String?  @db.VarChar(300)
  contactPhone     String?  @map("contact_phone") @db.VarChar(30)
  // Human-readable place resolved by the geocoder (e.g. "Ntinda, Nakawa, Kampala").
  formattedAddress String?  @map("formatted_address") @db.Text
  // true = pin confirmed inside Uganda and inside the chosen district by the
  // geocoder; false = validated offline (Uganda bounds + district proximity).
  isVerified       Boolean  @default(false) @map("is_verified")
  latitude         Decimal? @db.Decimal(10, 7)
  longitude        Decimal? @db.Decimal(10, 7)
  isDefault        Boolean  @default(false) @map("is_default")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders          Order[]
  serviceRequests ServiceRequest[]

  @@index([userId])
  @@map("addresses")
}

model Category {
  id           Int      @id @default(autoincrement())
  slug         String   @unique @db.VarChar(100)
  nameEn       String?  @map("name_en") @db.VarChar(100)
  nameLg       String?  @map("name_lg") @db.VarChar(100)
  imageUrl     String?  @map("image_url") @db.Text
  // Storefront menu icon key (e.g. "smartphone"); see frontend categoryIcons.
  icon         String?  @db.VarChar(50)
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  products     Product[]
  translations CategoryTranslation[]

  @@index([isActive])
  @@index([displayOrder])
  @@map("categories")
}

model CategoryTranslation {
  id          Int      @id @default(autoincrement())
  categoryId  Int      @map("category_id")
  language    Language
  name        String   @db.VarChar(100)
  description String?  @db.Text
  // true = machine-translated from English; regenerated when English changes.
  isAuto      Boolean  @default(false) @map("is_auto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@index([language])
  @@map("category_translations")
}

model Product {
  id                Int      @id @default(autoincrement())
  categoryId        Int      @map("category_id")
  slug              String   @unique @db.VarChar(200)
  sku               String?  @unique @db.VarChar(50)
  priceUgx          Int      @map("price_ugx")
  stockQuantity     Int      @default(0) @map("stock_quantity")
  unit              String   @default("piece") @db.VarChar(50)
  imageUrl          String?  @map("image_url") @db.Text
  isActive          Boolean  @default(true) @map("is_active")
  nameEn            String?  @map("name_en") @db.VarChar(200)
  nameLg            String?  @map("name_lg") @db.VarChar(200)
  descriptionEn     String?  @map("description_en") @db.Text
  descriptionLg     String?  @map("description_lg") @db.Text
  stock             Decimal? @default(0) @db.Decimal(10, 2)
  // General-merchandise fields (electronics, fashion, household...).
  brand             String?  @db.VarChar(100)
  // Ordered key/value specs, e.g. [{"label":"Storage","value":"128 GB"}].
  specifications    Json?
  // Optional "was" price shown struck-through when greater than priceUgx.
  compareAtPriceUgx Int?     @map("compare_at_price_ugx")
  isFeatured        Boolean  @default(false) @map("is_featured")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  category              Category               @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cartItems             CartItem[]
  orderItems            OrderItem[]
  wishlists             Wishlist[]
  translations          ProductTranslation[]
  images                ProductImage[]
  inventoryTransactions InventoryTransaction[]

  @@index([categoryId])
  @@index([isActive])
  @@index([stockQuantity])
  @@index([priceUgx])
  @@index([brand])
  @@map("products")
}

model ProductTranslation {
  id          Int      @id @default(autoincrement())
  productId   Int      @map("product_id")
  language    Language
  name        String   @db.VarChar(200)
  description String?  @db.Text
  // true = machine-translated from English; regenerated when English changes.
  isAuto      Boolean  @default(false) @map("is_auto")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@index([language])
  @@index([name])
  @@map("product_translations")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  imageUrl  String   @map("image_url") @db.Text
  altText   String?  @map("alt_text") @db.VarChar(255)
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model InventoryTransaction {
  id               Int                      @id @default(autoincrement())
  productId        Int                      @map("product_id")
  quantityChange   Int                      @map("quantity_change")
  previousQuantity Int                      @map("previous_quantity")
  newQuantity      Int                      @map("new_quantity")
  type             InventoryTransactionType
  reason           String?                  @db.VarChar(255)
  referenceId      String?                  @map("reference_id") @db.VarChar(100)
  createdBy        String?                  @map("created_by") @db.Uuid
  createdAt        DateTime                 @default(now()) @map("created_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  admin   Admin?  @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model Cart {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id           String   @id @default(uuid()) @db.Uuid
  cartId       String   @map("cart_id") @db.Uuid
  productId    Int      @map("product_id")
  quantity     Decimal  @default(1) @db.Decimal(10, 2)
  unitPriceUgx Int?     @map("unit_price_ugx")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                String       @id @default(uuid()) @db.Uuid
  orderNumber       String       @unique @map("order_number") @db.VarChar(30)
  userId            String       @map("user_id") @db.Uuid
  deliveryType      DeliveryType @map("delivery_type")
  deliveryAddressId String?      @map("delivery_address_id") @db.Uuid
  status            OrderStatus  @default(PENDING_PAYMENT)
  itemsSubtotal     Int          @map("items_subtotal")
  deliveryFee       Int          @default(0) @map("delivery_fee")
  totalAmount       Int          @map("total_amount")
  commitmentAmount  Int          @map("commitment_amount")
  remainingBalance  Int          @map("remaining_balance")
  notes             String?      @db.Text
  currency          String       @default("UGX") @db.VarChar(10)
  addressSnapshot   Json?        @map("address_snapshot")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  user            User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveryAddress Address?             @relation(fields: [deliveryAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  payments        Payment[]
  delivery        Delivery?
  chatMessages    ChatMessage[]
  consentRecords  ConsentRecord[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid()) @db.Uuid
  orderId      String  @map("order_id") @db.Uuid
  productId    Int     @map("product_id")
  productName  String  @map("product_name") @db.VarChar(200)
  unit         String  @db.VarChar(50)
  unitPriceUgx Int     @map("unit_price_ugx")
  quantity     Decimal @db.Decimal(10, 2)
  totalUgx     Int     @map("total_ugx")

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            Int          @id @default(autoincrement())
  orderId       String       @map("order_id") @db.Uuid
  statusFrom    OrderStatus? @map("status_from")
  statusTo      OrderStatus  @map("status_to")
  changedByType ActorType    @map("changed_by_type")
  changedById   String?      @map("changed_by_id") @db.VarChar(100)
  notes         String?      @db.Text
  createdAt     DateTime     @default(now()) @map("created_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_history")
}

model Payment {
  id             String            @id @default(uuid()) @db.Uuid
  orderId        String            @map("order_id") @db.Uuid
  purpose        PaymentPurpose    @default(COMMITMENT)
  paymentType    PaymentType       @map("payment_type")
  provider       PaymentProvider
  transactionRef String            @unique @map("transaction_ref") @db.VarChar(150)
  providerRef    String?           @map("provider_ref") @db.VarChar(150)
  amountUgx      Int               @map("amount_ugx")
  currency       String            @default("UGX") @db.VarChar(10)
  status         PaymentStatus     @default(PENDING)
  resultCode     PaymentResultCode @default(NONE) @map("result_code")
  failureMessage String?           @map("failure_message") @db.VarChar(500)
  expiresAt      DateTime?         @map("expires_at")
  verifiedAt     DateTime?         @map("verified_at")
  payload        Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)

  @@unique([provider, providerRef])
  @@index([orderId])
  @@index([transactionRef])
  @@index([providerRef])
  @@index([status])
  @@map("payments")
}

// Phase 7: fulfillment record. Exactly ONE delivery per order (unique order_id,
// DB-enforced). Order.addressSnapshot (Phase 5) remains the customer-facing
// immutable snapshot; the delivery row carries its own
// operational copy plus distance/fee/assignment lifecycle data.
model Delivery {
  id              String                 @id @default(uuid()) @db.Uuid
  orderId         String                 @unique @map("order_id") @db.Uuid
  fulfillmentType DeliveryType           @map("fulfillment_type")
  status          DeliveryStatus         @default(PENDING)
  deliveryFeeUgx  Int                    @default(0) @map("delivery_fee_ugx")
  // Road distance from the store when routed, otherwise an estimate.
  distanceKm      Decimal?               @map("distance_km") @db.Decimal(8, 3)
  straightLineKm  Decimal?               @map("straight_line_km") @db.Decimal(8, 3)
  etaMinutes      Int?                   @map("eta_minutes")
  // ROUTED (road network) | ESTIMATED (straight line x road factor)
  distanceSource  String?                @map("distance_source") @db.VarChar(20)
  assignedAdminId String?                @map("assigned_admin_id") @db.Uuid
  addressSnapshot Json?                  @map("address_snapshot")
  scheduledAt     DateTime?              @map("scheduled_at")
  startedAt       DateTime?              @map("started_at")
  completedAt     DateTime?              @map("completed_at")
  failureReason   DeliveryFailureReason? @map("failure_reason")
  failureMessage  String?                @map("failure_message") @db.VarChar(500)
  notes           String?                @db.VarChar(500)
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  order         Order  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  assignedAdmin Admin? @relation("DeliveryAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([fulfillmentType])
  @@index([assignedAdminId])
  @@index([createdAt])
  @@map("deliveries")
}

model DeliveryPricingConfig {
  id            Int      @id @default(autoincrement())
  warehouseLat  Decimal  @map("warehouse_lat") @db.Decimal(10, 7)
  warehouseLng  Decimal  @map("warehouse_lng") @db.Decimal(10, 7)
  baseFeeUgx    Int      @default(3000) @map("base_fee_ugx")
  freeRadiusKm  Decimal  @default(3.0) @map("free_radius_km") @db.Decimal(6, 2)
  perKmRateUgx  Int      @default(1200) @map("per_km_rate_ugx")
  minimumFeeUgx Int      @default(3000) @map("minimum_fee_ugx")
  // Human-readable dispatch point shown to staff (e.g. "Nakasero, Kampala").
  warehouseName String?  @map("warehouse_name") @db.VarChar(200)
  // Orders farther than this road distance are refused (null = no limit).
  maxDeliveryKm Decimal? @map("max_delivery_km") @db.Decimal(7, 2)
  isActive      Boolean  @default(true) @map("is_active")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("delivery_pricing_config")
}

model CommitmentRuleConfig {
  id              Int      @id @default(autoincrement())
  ruleType        RuleType @default(PERCENTAGE) @map("rule_type")
  percentageValue Decimal  @default(30.0) @map("percentage_value") @db.Decimal(5, 2)
  flatValueUgx    Int      @default(10000) @map("flat_value_ugx")
  minCommitment   Int      @default(5000) @map("min_commitment")
  isActive        Boolean  @default(true) @map("is_active")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("commitment_rule_config")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  title     String   @db.VarChar(150)
  message   String   @db.Text
  type      String   @default("ORDER_UPDATE") @db.VarChar(50)
  isRead    Boolean  @default(false) @map("is_read")
  linkUrl   String?  @map("link_url") @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notifications")
}

model AuditLog {
  id         Int      @id @default(autoincrement())
  adminId    String?  @map("admin_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityName String   @map("entity_name") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  details    Json?
  ipAddress  String?  @map("ip_address") @db.VarChar(50)
  createdAt  DateTime @default(now()) @map("created_at")

  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([adminId])
  @@index([entityName, entityId])
  @@map("audit_logs")
}

model Wishlist {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  productId Int      @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("wishlists")
}

enum OtpPurpose {
  SIGNUP
  VERIFY_EMAIL
  VERIFY_PHONE
  PASSWORD_RESET
  CHANGE_EMAIL
  CHANGE_PHONE
}

enum OtpChannel {
  SMS
  EMAIL
}

// One-time verification codes. Only a keyed hash of the code is stored; codes
// expire, allow a limited number of guesses and are single-use.
model OtpCode {
  id             String     @id @default(uuid()) @db.Uuid
  // Normalized destination (+2567XXXXXXXX or a lower-cased email address).
  // Column name kept from the phone-only version.
  phone          String     @db.VarChar(255)
  channel        OtpChannel @default(SMS)
  purpose        OtpPurpose @default(VERIFY_PHONE)
  userId         String?    @map("user_id") @db.Uuid
  codeHash       String     @map("code_hash") @db.VarChar(255)
  expiresAt      DateTime   @map("expires_at")
  consumed       Boolean    @default(false)
  consumedAt     DateTime?  @map("consumed_at")
  attempts       Int        @default(0)
  maxAttempts    Int        @default(5) @map("max_attempts")
  // QUEUED | SENT | DELIVERED | FAILED | SUPPRESSED (decoy: nothing was sent)
  deliveryStatus String     @default("QUEUED") @map("delivery_status") @db.VarChar(20)
  providerRef    String?    @map("provider_ref") @db.VarChar(150)
  ipAddress      String?    @map("ip_address") @db.VarChar(64)
  createdAt      DateTime   @default(now()) @map("created_at")

  @@index([phone])
  @@index([phone, purpose, createdAt])
  @@index([providerRef])
  @@map("otp_codes")
}

// Account-security audit trail (OTP sent/verified/failed, password and
// contact changes). Never contains codes or passwords.
model SecurityEvent {
  id        Int      @id @default(autoincrement())
  userId    String?  @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  // Masked destination, e.g. "+25677*****23" or "j***@gmail.com".
  target    String?  @db.VarChar(255)
  ipAddress String?  @map("ip_address") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.VarChar(300)
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([type])
  @@map("security_events")
}

enum ConsentType {
  TERMS
  PRIVACY
  MARKETING
}

// Append-only record of what a customer agreed to (or withdrew), when, and
// which document version they were shown.
model ConsentRecord {
  id        Int         @id @default(autoincrement())
  userId    String      @map("user_id") @db.Uuid
  orderId   String?     @map("order_id") @db.Uuid
  type      ConsentType
  granted   Boolean
  version   String?     @db.VarChar(40)
  // CHECKOUT | ACCOUNT | UNSUBSCRIBE_LINK
  source    String      @db.VarChar(30)
  ipAddress String?     @map("ip_address") @db.VarChar(64)
  userAgent String?     @map("user_agent") @db.VarChar(300)
  createdAt DateTime    @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([userId, type, createdAt])
  @@index([orderId])
  @@map("consent_records")
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  UNSUBSCRIBED
}

// Newsletter / new-arrivals mailing list (double opt-in).
model NewsletterSubscriber {
  id                  String           @id @default(uuid()) @db.Uuid
  email               String           @unique @db.VarChar(255)
  status              SubscriberStatus @default(PENDING)
  // sha256 of the emailed confirmation token (single-use).
  confirmTokenHash    String?          @unique @map("confirm_token_hash") @db.VarChar(64)
  confirmTokenExpires DateTime?        @map("confirm_token_expires")
  // Random token embedded in every email's unsubscribe link.
  unsubscribeToken    String           @unique @map("unsubscribe_token") @db.VarChar(64)
  language            String           @default("en") @db.VarChar(5)
  source              String           @default("FOOTER") @db.VarChar(30)
  consentIp           String?          @map("consent_ip") @db.VarChar(64)
  confirmedAt         DateTime?        @map("confirmed_at")
  unsubscribedAt      DateTime?        @map("unsubscribed_at")
  lastConfirmSentAt   DateTime?        @map("last_confirm_sent_at")
  createdAt           DateTime         @default(now()) @map("created_at")
  updatedAt           DateTime         @updatedAt @map("updated_at")

  @@index([status])
  @@map("newsletter_subscribers")
}

// "New arrivals" digest bookkeeping: products created up to this instant
// have already been announced (single row, id = 1).
model NewArrivalsDigest {
  id              Int      @id @default(1)
  lastAnnouncedAt DateTime @map("last_announced_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("new_arrivals_digest")
}

// ============================================================
// Admin notifications (new orders, payments, customer messages).
// Read state is per admin so every operator has their own unread list.
// ============================================================
model AdminNotification {
  id        String   @id @default(uuid()) @db.Uuid
  type      String   @db.VarChar(40)
  title     String   @db.VarChar(150)
  message   String   @db.Text
  linkUrl   String?  @map("link_url") @db.Text
  orderId   String?  @map("order_id") @db.Uuid
  metadata  Json?
  createdAt DateTime @default(now()) @map("created_at")

  reads AdminNotificationRead[]

  @@index([createdAt])
  @@index([type])
  @@map("admin_notifications")
}

model AdminNotificationRead {
  notificationId String   @map("notification_id") @db.Uuid
  adminId        String   @map("admin_id") @db.Uuid
  readAt         DateTime @default(now()) @map("read_at")

  notification AdminNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  admin        Admin             @relation(fields: [adminId], references: [id], onDelete: Cascade)

  @@id([notificationId, adminId])
  @@index([adminId])
  @@map("admin_notification_reads")
}

// ============================================================
// Customer <-> store support chat. One thread per customer; a message may
// reference an order so staff see the context.
// ============================================================
enum ChatSender {
  CUSTOMER
  ADMIN
}

model Conversation {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @unique @map("user_id") @db.Uuid
  lastMessageAt  DateTime? @map("last_message_at")
  lastMessage    String?   @map("last_message") @db.VarChar(300)
  // Unread counters, maintained in the same transaction as each message.
  customerUnread Int       @default(0) @map("customer_unread")
  adminUnread    Int       @default(0) @map("admin_unread")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  @@index([lastMessageAt])
  @@map("conversations")
}

model ChatMessage {
  id               String     @id @default(uuid()) @db.Uuid
  conversationId   String     @map("conversation_id") @db.Uuid
  senderType       ChatSender @map("sender_type")
  senderAdminId    String?    @map("sender_admin_id") @db.Uuid
  body             String     @db.Text
  orderId          String?    @map("order_id") @db.Uuid
  serviceRequestId String?    @map("service_request_id") @db.Uuid
  // Receipts: reached the recipient's device / opened by the recipient.
  deliveredAt      DateTime?  @map("delivered_at")
  readAt           DateTime?  @map("read_at")
  createdAt        DateTime   @default(now()) @map("created_at")

  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderAdmin    Admin?          @relation(fields: [senderAdminId], references: [id], onDelete: SetNull)
  order          Order?          @relation(fields: [orderId], references: [id], onDelete: SetNull)
  serviceRequest ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

// ============================================================
// Home services (plumbing, electrical, cleaning, repairs...).
// Admin curates the service catalogue and the technicians; customers book a
// visit to a verified address; staff confirm, quote, assign and complete.
// ============================================================
enum ServicePriceType {
  FIXED // priceFromUgx is the full price of the job
  HOURLY // priceFromUgx per hour on site
  INSPECTION // priceFromUgx is the call-out fee; the job is quoted on site
}

enum ServiceRequestStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ServicePaymentStatus {
  UNPAID
  PAID
}

model Service {
  id            Int              @id @default(autoincrement())
  slug          String           @unique @db.VarChar(120)
  // English is the source of truth; other languages are machine-translated
  // into `translations` ({ "LG": { "name": "...", "description": "..." } }).
  nameEn        String           @map("name_en") @db.VarChar(150)
  descriptionEn String?          @map("description_en") @db.Text
  translations  Json?
  icon          String?          @db.VarChar(50)
  imageUrl      String?          @map("image_url") @db.Text
  priceType     ServicePriceType @default(INSPECTION) @map("price_type")
  priceFromUgx  Int              @default(0) @map("price_from_ugx")
  // Typical job duration shown to customers, e.g. "1-2 hours".
  durationText  String?          @map("duration_text") @db.VarChar(60)
  displayOrder  Int              @default(0) @map("display_order")
  isActive      Boolean          @default(true) @map("is_active")
  createdAt     DateTime         @default(now()) @map("created_at")
  updatedAt     DateTime         @updatedAt @map("updated_at")

  requests  ServiceRequest[]
  providers ServiceProviderSkill[]

  @@index([isActive])
  @@map("services")
}

model ServiceProvider {
  id        String   @id @default(uuid()) @db.Uuid
  fullName  String   @map("full_name") @db.VarChar(150)
  phone     String   @db.VarChar(30)
  // Areas the technician covers, free text (e.g. "Kampala, Wakiso").
  coverage  String?  @db.VarChar(300)
  notes     String?  @db.Text
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  skills   ServiceProviderSkill[]
  requests ServiceRequest[]

  @@map("service_providers")
}

model ServiceProviderSkill {
  providerId String @map("provider_id") @db.Uuid
  serviceId  Int    @map("service_id")

  provider ServiceProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  service  Service         @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([providerId, serviceId])
  @@map("service_provider_skills")
}

model ServiceRequest {
  id              String               @id @default(uuid()) @db.Uuid
  requestNumber   String               @unique @map("request_number") @db.VarChar(30)
  userId          String               @map("user_id") @db.Uuid
  serviceId       Int                  @map("service_id")
  addressId       String?              @map("address_id") @db.Uuid
  // Immutable copy of the verified address at booking time.
  addressSnapshot Json                 @map("address_snapshot")
  description     String               @db.Text
  preferredDate   DateTime             @map("preferred_date") @db.Date
  preferredSlot   String               @map("preferred_slot") @db.VarChar(20)
  contactPhone    String               @map("contact_phone") @db.VarChar(30)
  status          ServiceRequestStatus @default(PENDING)
  // Snapshot of the advertised price at booking time.
  priceType       ServicePriceType     @map("price_type")
  priceFromUgx    Int                  @map("price_from_ugx")
  // Final price agreed by staff (set when confirming or after inspection).
  quotedPriceUgx  Int?                 @map("quoted_price_ugx")
  distanceKm      Decimal?             @map("distance_km") @db.Decimal(8, 3)
  etaMinutes      Int?                 @map("eta_minutes")
  distanceSource  String?              @map("distance_source") @db.VarChar(20)
  providerId      String?              @map("provider_id") @db.Uuid
  scheduledAt     DateTime?            @map("scheduled_at")
  completedAt     DateTime?            @map("completed_at")
  paymentStatus   ServicePaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod   PaymentProvider?     @map("payment_method")
  paymentRef      String?              @map("payment_ref") @db.VarChar(100)
  cancelReason    String?              @map("cancel_reason") @db.VarChar(500)
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  user         User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  service      Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  address      Address?              @relation(fields: [addressId], references: [id], onDelete: SetNull)
  provider     ServiceProvider?      @relation(fields: [providerId], references: [id], onDelete: SetNull)
  events       ServiceRequestEvent[]
  chatMessages ChatMessage[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@map("service_requests")
}

model ServiceRequestEvent {
  id         Int                   @id @default(autoincrement())
  requestId  String                @map("request_id") @db.Uuid
  statusFrom ServiceRequestStatus? @map("status_from")
  statusTo   ServiceRequestStatus  @map("status_to")
  actorType  ActorType             @map("actor_type")
  adminId    String?               @map("admin_id") @db.Uuid
  note       String?               @db.VarChar(500)
  createdAt  DateTime              @default(now()) @map("created_at")

  request ServiceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  admin   Admin?         @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([requestId])
  @@map("service_request_events")
}

// ============================================================
// Storefront content the owner controls from the admin console.
// English is the source of truth; other languages are machine-translated
// into `translations` ({ "LG": { "name": "...", "description": "..." } }).
// ============================================================

// Single-row table (id is always 1): public contact details + top-bar notice.
model StoreProfile {
  id                       Int      @id @default(1)
  storeName                String   @default("UgaMarket") @map("store_name") @db.VarChar(100)
  supportPhone             String?  @map("support_phone") @db.VarChar(30)
  supportEmail             String?  @map("support_email") @db.VarChar(255)
  whatsappPhone            String?  @map("whatsapp_phone") @db.VarChar(30)
  addressText              String?  @map("address_text") @db.VarChar(300)
  businessHours            String?  @map("business_hours") @db.VarChar(150)
  // Optional announcement shown in the storefront top bar (English).
  announcement             String?  @db.VarChar(200)
  announcementTranslations Json?    @map("announcement_translations")
  updatedAt                DateTime @updatedAt @map("updated_at")

  @@map("store_profile")
}

// Frequently asked questions shown on the storefront help page.
model Faq {
  id           Int      @id @default(autoincrement())
  questionEn   String   @map("question_en") @db.VarChar(200)
  answerEn     String   @map("answer_en") @db.Text
  translations Json?
  displayOrder Int      @default(0) @map("display_order")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([isActive, displayOrder])
  @@map("faqs")
}

// ============================================================
// Customer -> store voice calls (WebRTC audio, signalled over SSE).
// Audio flows peer-to-peer (DTLS-SRTP encrypted); this table is the call
// log and the authority on who may signal whom.
// ============================================================
enum CallStatus {
  RINGING
  ACTIVE
  ENDED
  MISSED
  REJECTED
  FAILED
}

// INBOUND: the customer called the store. OUTBOUND: staff called the customer.
enum CallDirection {
  INBOUND
  OUTBOUND
}

model CallSession {
  id         String        @id @default(uuid()) @db.Uuid
  userId     String        @map("user_id") @db.Uuid
  adminId    String?       @map("admin_id") @db.Uuid
  direction  CallDirection @default(INBOUND)
  status     CallStatus    @default(RINGING)
  endReason  String?       @map("end_reason") @db.VarChar(40)
  endedBy    String?       @map("ended_by") @db.VarChar(10)
  answeredAt DateTime?     @map("answered_at")
  endedAt    DateTime?     @map("ended_at")
  createdAt  DateTime      @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  admin Admin? @relation(fields: [adminId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([status])
  @@map("call_sessions")
}
