# ═════════════════════════════════════════════════════════════════════════════
#  UgaMarket API — LOCAL DEVELOPMENT settings
# ═════════════════════════════════════════════════════════════════════════════
#  Copy this file to  backend/.env  (gitignored) and fill in your own values.
#  NEVER commit backend/.env.
#
#  Which file is used where?
#    Local development ............ backend/.env            (this template)
#    Render (free hosting) ........ Render dashboard → Environment  (see render.yaml)
#    Docker / own server .......... .env.production at the repo root
#                                   (template: .env.production.example)
#    Shop / admin websites ........ frontend/.env.local and admin/.env.local
#
#  Everything below has a safe development default unless marked REQUIRED.
# ═════════════════════════════════════════════════════════════════════════════


# ── 1. Runtime ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# 0.0.0.0 = reachable from containers/other devices; 127.0.0.1 = this PC only.
HOST=0.0.0.0


# ── 2. Database (PostgreSQL) — REQUIRED ─────────────────────────────────────
# postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/ugamarket?schema=public


# ── 3. Login security ───────────────────────────────────────────────────────
# Signing keys for customer and staff logins. Two DIFFERENT long random
# values (16+ chars here, 32+ in production). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_chars
ADMIN_JWT_SECRET=replace_with_a_different_secure_secret_for_admins
# How long a login stays valid: customers / staff.
JWT_EXPIRES_IN=7d
ADMIN_JWT_EXPIRES_IN=1d


# ── 4. Owner and first admin accounts ───────────────────────────────────────
# Created when the database is set up (seed). Changing these later does NOT
# change existing accounts — manage people in the admin console → Staff accounts.
#
# ADMIN_1 = the OWNER: the ONE super admin. Only the owner adds staff and
#           assigns roles (Admin / Dispatcher).
ADMIN_1_EMAIL=owner@ugamarket.ug
ADMIN_1_PASSWORD=change_this_admin_password_in_env
ADMIN_1_NAME=Owner
# ADMIN_2 = a first regular Admin (catalogue, prices, settings; cannot manage staff).
# Must be a different email from ADMIN_1.
ADMIN_2_EMAIL=admin@ugamarket.ug
ADMIN_2_PASSWORD=change_this_ops_password_in_env
ADMIN_2_NAME=Operations Admin


# ── 5. Web addresses ────────────────────────────────────────────────────────
# Websites allowed to call this API (comma-separated, exact, no trailing "/").
# Dev: shop (3000), admin (5173), API itself (4000).
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:4000
# The customer shop's address: customers return here after a payment step.
FRONTEND_URL=http://localhost:3000


# ── 6. Payments — MTN MoMo & Airtel Money (cards are not accepted) ──────────
# MOCK = fake payments for development (refused in production).
# FLUTTERWAVE = real mobile money (sandbox when PAYMENT_MODE=TEST).
PAYMENT_PROVIDER=MOCK
# TEST (sandbox keys) or LIVE (real money, live keys).
PAYMENT_MODE=TEST
# Flutterwave dashboard → Settings → API keys. Only with PAYMENT_PROVIDER=FLUTTERWAVE.
FLW_PUBLIC_KEY=
FLW_SECRET_KEY=
# Must equal the "secret hash" set in Flutterwave → Settings → Webhooks.
PAYMENT_WEBHOOK_SECRET=replace_with_webhook_signature_secret


# ── 7. Product photos ───────────────────────────────────────────────────────
# Empty  = photos saved on this computer (backend/uploads/images).
# Set    = photos stored on Cloudinary's CDN (REQUIRED on Render).
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=ugamarket


# ── 8. Addresses, maps and delivery distance (OpenStreetMap) ────────────────
# NOMINATIM / OSRM = free public services (fine for low volume).
# NONE = offline: addresses checked against the built-in Uganda district list.
GEOCODER_PROVIDER=NOMINATIM
NOMINATIM_URL=https://nominatim.openstreetmap.org
ROUTING_PROVIDER=OSRM
OSRM_URL=https://router.project-osrm.org
# A real email you read — required by OpenStreetMap's usage policy.
GEO_CONTACT_EMAIL=support@ugamarket.ug
# Used only when routing is off: straight-line distance × this factor.
ROAD_DISTANCE_FACTOR=1.35


# ── 9. Automatic translation (admins write English; shop shows LG / SW / FR) ─
# MYMEMORY = free, no key (weak Luganda)   GOOGLE = best quality, needs a key
# LIBRETRANSLATE = self-hosted             NONE = English everywhere
TRANSLATION_PROVIDER=MYMEMORY
MYMEMORY_EMAIL=
GOOGLE_TRANSLATE_API_KEY=
LIBRETRANSLATE_URL=
LIBRETRANSLATE_API_KEY=


# ── 10. Starting store settings (used ONLY when the database is set up) ─────
# Afterwards, change them in the admin console → Delivery & deposit.
# Dispatch point (default: Nakasero Market, Kampala)
WAREHOUSE_LATITUDE=0.3136
WAREHOUSE_LONGITUDE=32.5811
# Delivery fee (UGX): base fee covers the first FREE_RADIUS km, then per km.
DELIVERY_BASE_FEE=3000
DELIVERY_FREE_RADIUS_KM=3.0
DELIVERY_PER_KM_RATE=1200
DELIVERY_MINIMUM_FEE=3000
# Deposit customers pay to place an order: PERCENTAGE or FLAT.
COMMITMENT_RULE_TYPE=PERCENTAGE
COMMITMENT_PERCENTAGE=30.0
COMMITMENT_MIN_AMOUNT=5000


# ── 11. Advanced (optional — defaults are fine) ─────────────────────────────
# Minutes before an unconfirmed mobile-money attempt expires.
PAYMENT_ATTEMPT_TTL_MINUTES=30
# Requests allowed per 15 minutes (per signed-in account, per IP for visitors)
# and login/register attempts per 15 minutes per IP.
# RATE_LIMIT_API_MAX=600
# RATE_LIMIT_AUTH_MAX=20
# Which proxies to trust for the visitor's IP (default trusts private networks).
# TRUST_PROXY=loopback, linklocal, uniquelocal
